{
  "env": {
    "browser": true,
    "es2021": true
  },
  "ignorePatterns": ["dist/**"],
  "extends": ["eslint:recommended", "prettier"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "overrides": [
    {
      "files": ["**/*.test.js"],
      "globals": {
        "vi": "readonly"
      }
    },
    {
      "files": [
        "vite.config.js",
        "vitest.config.js",
        "postcss.config.js",
        "tailwind.config.js",
        "scripts/**/*.mjs"
      ],
      "env": {
        "node": true
      }
    }
  ],
  "rules": {
    "no-console": "off",
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
    "prefer-const": "warn"
  }
}
